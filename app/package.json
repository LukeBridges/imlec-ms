{
  "name": "imlec",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "serve": "ng serve",
    "serve:prod": "ng serve --configuration=production",
    "serve:api": "cd ../api && npm run serve",
    "build": "ng build",
    "build:prod": "ng build --configuration=production",
    "build:prod-stats": "npm run build:prod && source-map-explorer ./../*.js --html ./../stats.html",
    "watch": "ng build --watch",
    "test": "vitest --run",
    "test:coverage": "vitest --run --coverage"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.1",
    "@angular/cdk": "^22.2.1",
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/material": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/router": "^22.2.1",
    "@ngrx/effects": "^21.1.1",
    "@ngrx/entity": "^21.1.1",
    "@ngrx/operators": "^21.1.1",
    "@ngrx/router-store": "^21.1.1",
    "@ngrx/store": "^21.1.1",
    "@ngrx/store-devtools": "^21.1.1",
    "rxjs": "^7.4.0",
    "tslib": "^2.6.2",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.7.5",
    "@analogjs/vitest-angular": "^2.7.5",
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.1",
    "@types/node": "^22.18.3",
    "@vitest/coverage-v8": "^5.0.3",
    "jsdom": "^26.1.0",
    "source-map-explorer": "^2.5.2",
    "typescript": "6.0.3",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "@ngrx/effects": {
      "@angular/common": "$@angular/common",
      "@angular/core": "$@angular/core"
    },
    "@ngrx/entity": {
      "@angular/common": "$@angular/common",
      "@angular/core": "$@angular/core"
    },
    "@ngrx/router-store": {
      "@angular/common": "$@angular/common",
      "@angular/core": "$@angular/core",
      "@angular/router": "$@angular/router"
    },
    "@ngrx/store-devtools": {
      "@angular/common": "$@angular/common",
      "@angular/core": "$@angular/core"
    },
    "@ngrx/store": {
      "@angular/common": "$@angular/common",
      "@angular/core": "$@angular/core"
    }
  },
  "allowScripts": {
    "@parcel/watcher": true,
    "esbuild": true,
    "lmdb": true,
    "msgpackr-extract": true
  }
}
